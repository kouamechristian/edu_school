{% extends 'support/base.html.twig' %}

{% block title %}{{ module.title }} — Aide{% endblock %}

{% block support_body %}
<div class="sup-layout">
    {% include 'support/_toc.html.twig' %}

    <div>
        {# En-tête du module #}
        <div class="sup-reveal d-flex align-items-center gap-3 mb-3">
            <span style="width:3rem;height:3rem;border-radius:.8rem;display:flex;align-items:center;justify-content:center;
                         background:linear-gradient(135deg,#1e3a5f,#0f766e);color:#fff;font-size:1.2rem;flex:none;">
                <i class="fas {{ module.icon }}"></i>
            </span>
            <div>
                <nav class="small text-muted mb-1">
                    <a href="{{ path('app_support') }}" class="text-decoration-none text-muted">Aide</a>
                    <i class="fas fa-angle-right mx-1"></i>{{ module.title }}
                </nav>
                <h1 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:1.5rem;margin:0;">{{ module.title }}</h1>
            </div>
        </div>
        <p class="text-muted sup-reveal mb-4">{{ module.abstract }}</p>

        {# Tâches #}
        {% for task in module.tasks %}
            <section class="card mb-3 sup-reveal sup-task" data-title="{{ task.title|lower }}">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge rounded-pill" style="background:#0f766e;">Guide {{ loop.index }}</span>
                        <h2 class="h6 fw-bold mb-0">{{ task.title }}</h2>
                    </div>

                    <div class="row g-4">
                        {# Étapes #}
                        <div class="col-lg-6">
                            <ol class="sup-steps" style="list-style:none;counter-reset:s;padding-left:0;margin:0;">
                                {% for step in task.steps %}
                                    <li style="counter-increment:s;position:relative;padding-left:2.4rem;margin-bottom:.9rem;line-height:1.6;">
                                        <span style="position:absolute;left:0;top:-.1rem;width:1.7rem;height:1.7rem;border-radius:50%;
                                                     background:rgba(15,118,110,.12);color:#0f766e;font-weight:700;font-size:.8rem;
                                                     display:flex;align-items:center;justify-content:center;"
                                              aria-hidden="true">{{ loop.index }}</span>
                                        {{ step|raw }}
                                    </li>
                                {% endfor %}
                            </ol>

                            {% if task.tip is defined and task.tip %}
                                <div style="border-left:4px solid #f59e0b;background:rgba(245,158,11,.1);padding:.7rem .9rem;border-radius:.4rem;margin-top:.3rem;">
                                    <strong style="color:#b45309;"><i class="fas fa-lightbulb me-1"></i>Astuce</strong>
                                    <div class="small mt-1">{{ task.tip }}</div>
                                </div>
                            {% endif %}
                        </div>

                        {# Capture #}
                        <div class="col-lg-6">
                            {% if task.screenshot_exists %}
                                <button type="button" class="border-0 bg-transparent p-0 w-100 sup-shot"
                                        data-src="{{ asset(task.screenshot_url) }}" data-caption="{{ task.title }}"
                                        style="cursor:zoom-in;">
                                    <img src="{{ asset(task.screenshot_url) }}" alt="{{ task.title }}"
                                         class="img-fluid rounded shadow-sm" style="border:1px solid rgba(148,163,184,.3);width:100%;">
                                    <span class="d-block text-center small text-muted mt-1"><i class="fas fa-expand me-1"></i>Agrandir</span>
                                </button>
                            {% else %}
                                {# Emplacement réservé : déposer le PNG suffit à l'afficher. #}
                                <div class="d-flex flex-column align-items-center justify-content-center text-center h-100"
                                     style="min-height:180px;border:2px dashed rgba(148,163,184,.5);border-radius:.6rem;
                                            background:rgba(148,163,184,.06);padding:1.2rem;">
                                    <i class="fas fa-image fa-2x mb-2" style="color:#94a3b8;"></i>
                                    <div class="small text-muted mb-1">Capture à ajouter</div>
                                    <code class="small">public/images/support/{{ task.screenshot }}.png</code>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </section>
        {% endfor %}

        <div id="supTaskEmpty" class="text-muted text-center py-4" style="display:none;">
            Aucun guide de ce module ne correspond à votre recherche.
        </div>

        {# Navigation module précédent / suivant #}
        <div class="d-flex justify-content-between gap-2 mt-3 sup-reveal">
            {% if previous %}
                <a href="{{ path('app_support_module', {'slug': previous.slug}) }}" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-1"></i>{{ previous.title }}
                </a>
            {% else %}<span></span>{% endif %}
            {% if next %}
                <a href="{{ path('app_support_module', {'slug': next.slug}) }}" class="btn btn-outline-secondary ms-auto"
                   style="border-color:#0f766e;color:#0f766e;">
                    {{ next.title }}<i class="fas fa-arrow-right ms-1"></i>
                </a>
            {% endif %}
        </div>
    </div>
</div>

{# Visionneuse plein écran des captures #}
<div id="supLightbox" class="d-none" style="position:fixed;inset:0;z-index:2000;background:rgba(15,23,41,.88);
     align-items:center;justify-content:center;padding:2rem;cursor:zoom-out;" role="dialog" aria-modal="true">
    <figure style="margin:0;max-width:1100px;text-align:center;">
        <img id="supLightboxImg" src="" alt="" style="max-width:100%;max-height:80vh;border-radius:.5rem;box-shadow:0 1rem 3rem rgba(0,0,0,.5);">
        <figcaption id="supLightboxCap" style="color:#e2e8f0;margin-top:.8rem;font-size:.9rem;"></figcaption>
    </figure>
    <button type="button" id="supLightboxClose" aria-label="Fermer"
            style="position:absolute;top:1.2rem;right:1.4rem;background:rgba(255,255,255,.15);border:0;color:#fff;
                   width:2.4rem;height:2.4rem;border-radius:50%;font-size:1.1rem;cursor:pointer;">
        <i class="fas fa-xmark"></i>
    </button>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Recherche : filtre les guides du module courant.
    (function () {
        var input = document.getElementById('supSearch');
        var tasks = Array.prototype.slice.call(document.querySelectorAll('.sup-task'));
        var empty = document.getElementById('supTaskEmpty');
        if (!input) { return; }
        function fold(s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }
        input.addEventListener('input', function () {
            var q = fold(input.value.trim()), shown = 0;
            tasks.forEach(function (t) {
                var match = q === '' || fold(t.getAttribute('data-title')).indexOf(q) !== -1;
                t.style.display = match ? '' : 'none';
                if (match) { shown++; }
            });
            empty.style.display = shown === 0 ? 'block' : 'none';
        });
    })();

    // Visionneuse plein écran.
    (function () {
        var box = document.getElementById('supLightbox');
        var img = document.getElementById('supLightboxImg');
        var cap = document.getElementById('supLightboxCap');
        if (!box) { return; }
        function open(src, caption) {
            img.src = src; img.alt = caption; cap.textContent = caption;
            box.classList.remove('d-none'); box.style.display = 'flex'; document.body.style.overflow = 'hidden';
        }
        function close() { box.classList.add('d-none'); box.style.display = 'none'; img.src = ''; document.body.style.overflow = ''; }
        document.querySelectorAll('.sup-shot').forEach(function (b) {
            b.addEventListener('click', function () { open(b.getAttribute('data-src'), b.getAttribute('data-caption')); });
        });
        box.addEventListener('click', function (e) { if (e.target === box || e.target.closest('#supLightboxClose')) { close(); } });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { close(); } });
    })();
</script>
{% endblock %}
