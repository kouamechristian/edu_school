{% extends 'support/base.html.twig' %}

{% block title %}Centre d'aide{% endblock %}

{% block support_body %}
<div class="sup-reveal" style="text-align:center;max-width:720px;margin:1rem auto 2rem;">
    <div style="width:64px;height:64px;border-radius:18px;margin:0 auto .9rem;display:flex;align-items:center;justify-content:center;
                background:linear-gradient(135deg,#1e3a5f,#0f766e);color:#fff;font-size:1.6rem;">
        <i class="fas fa-life-ring"></i>
    </div>
    <h1 style="font-family:'Poppins',sans-serif;font-weight:600;font-size:1.7rem;margin-bottom:.5rem;">Comment pouvons-nous vous aider ?</h1>
    <p class="text-muted mb-0">
        Des guides pas à pas, illustrés, pour accomplir les tâches courantes d'EDU-SCHOOL.
        Choisissez un module ci-dessous ou utilisez la recherche.
    </p>
</div>

<div class="sup-layout">
    {% include 'support/_toc.html.twig' %}

    <div>
        <div class="row g-3" id="supModuleGrid">
            {% for item in modules %}
                <div class="col-md-6 sup-card-wrap sup-reveal" data-title="{{ item.title|lower }} {{ item.abstract|lower }}">
                    <a href="{{ path('app_support_module', {'slug': item.slug}) }}" class="text-decoration-none text-reset">
                        <div class="card h-100" style="transition:transform .15s ease, box-shadow .15s ease;"
                             onmouseover="this.style.transform='translateY(-3px)';this.style.boxShadow='0 .6rem 1.5rem rgba(15,23,41,.13)'"
                             onmouseout="this.style.transform='';this.style.boxShadow=''">
                            <div class="card-body">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <span style="width:2.4rem;height:2.4rem;border-radius:.7rem;display:flex;align-items:center;justify-content:center;
                                                 background:rgba(15,118,110,.12);color:#0f766e;">
                                        <i class="fas {{ item.icon }}"></i>
                                    </span>
                                    <h2 class="h6 fw-bold mb-0">{{ item.title }}</h2>
                                </div>
                                <p class="text-muted small mb-2">{{ item.abstract }}</p>
                                <span class="badge" style="background:rgba(15,118,110,.12);color:#0f766e;">
                                    {{ item.task_count }} guide{{ item.task_count > 1 ? 's' : '' }}
                                </span>
                            </div>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
        <div id="supNoResult" class="text-muted text-center py-5" style="display:none;">
            <i class="fas fa-circle-question fa-2x mb-2 d-block"></i>
            Aucun module ne correspond à votre recherche.
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    // Filtrage instantané des modules sur l'accueil.
    (function () {
        var input = document.getElementById('supSearch');
        var cards = Array.prototype.slice.call(document.querySelectorAll('#supModuleGrid .sup-card-wrap'));
        var empty = document.getElementById('supNoResult');
        if (!input) { return; }

        function fold(s) { return s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase(); }

        input.addEventListener('input', function () {
            var q = fold(input.value.trim());
            var shown = 0;
            cards.forEach(function (c) {
                var match = q === '' || fold(c.getAttribute('data-title')).indexOf(q) !== -1;
                c.style.display = match ? '' : 'none';
                if (match) { shown++; }
            });
            empty.style.display = shown === 0 ? 'block' : 'none';
        });
    })();
</script>
{% endblock %}
