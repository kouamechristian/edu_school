{# ==========================================================================
   EDU-SCHOOL — Centre d'aide : gabarit racine autonome

   Page publique et indépendante de base.html.twig : ni sidebar applicative,
   ni contexte établissement/année, aucune dépendance à un utilisateur connecté.
   Reprend la charte graphique via public/css/styles.css.
   ========================================================================== #}
<!DOCTYPE html>
<html lang="fr" data-bs-theme="light">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Centre d'aide{% endblock %} — EDU-SCHOOL</title>

    <link rel="icon" type="image/png" href="{{ asset('images/logo-edu-school.png') }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/styles.css') }}">

    <style>
        body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background-color: #f4f6f9; }
        [data-bs-theme="dark"] body { background-color: var(--es-body-bg, #0f1729); }

        /* ── En-tête ── */
        .sup-topbar { position: sticky; top: 0; z-index: 1030;
                      background: linear-gradient(120deg, #1e3a5f, #0f766e);
                      color: #fff; box-shadow: 0 .125rem .5rem rgba(15, 23, 41, .18); }
        .sup-topbar__inner { display: flex; align-items: center; gap: 1rem; padding: .7rem 1.25rem; }
        .sup-topbar__brand { display: flex; align-items: center; gap: .65rem; color: #fff;
                             text-decoration: none; font-family: 'Poppins', sans-serif; font-weight: 600; }
        .sup-topbar__brand img { height: 34px; }
        .sup-topbar__brand small { display: block; font-family: 'Inter', sans-serif; font-weight: 400;
                                   font-size: .72rem; opacity: .8; }
        .sup-search { position: relative; flex: 1 1 auto; max-width: 460px; margin-left: 1rem; }
        .sup-search input { width: 100%; padding: .45rem 1rem .45rem 2.1rem; border: 1px solid rgba(255,255,255,.2);
                            border-radius: .6rem; background: rgba(255,255,255,.14); color: #fff; font-size: .875rem; }
        .sup-search input::placeholder { color: rgba(255,255,255,.65); }
        .sup-search input:focus { outline: none; background: rgba(255,255,255,.22); border-color: rgba(255,255,255,.45); }
        .sup-search i { position: absolute; left: .7rem; top: 50%; transform: translateY(-50%);
                        color: rgba(255,255,255,.65); font-size: .85rem; pointer-events: none; }
        .sup-topbar__actions { margin-left: auto; display: flex; gap: .5rem; }
        .sup-topbar__btn { color: #fff; background: rgba(255,255,255,.14); border: 0; border-radius: .5rem;
                           padding: .4rem .75rem; font-size: .85rem; text-decoration: none; line-height: 1.4; }
        .sup-topbar__btn:hover { background: rgba(255,255,255,.24); color: #fff; }

        .sup-shell { max-width: 1180px; margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
        .sup-layout { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 1.5rem; align-items: start; }
        @media (max-width: 991.98px) { .sup-layout { grid-template-columns: 1fr; } }

        /* ── Sommaire des modules ── */
        .sup-toc { position: sticky; top: 4.75rem; max-height: calc(100vh - 6rem); overflow-y: auto; }
        @media (max-width: 991.98px) { .sup-toc { position: static; max-height: none; } .sup-toc:not(.show) { display: none; } }
        @media (min-width: 992px) { .sup-toc { display: block !important; } }
        .sup-toc__link { display: flex; align-items: center; gap: .6rem; padding: .5rem .65rem; border-radius: .5rem;
                         color: inherit; text-decoration: none; font-size: .9rem; border-left: 3px solid transparent; }
        .sup-toc__link:hover { background: rgba(30, 58, 95, .07); }
        .sup-toc__link.active { background: rgba(15, 118, 110, .1); border-left-color: #0f766e; color: #0f766e; font-weight: 600; }
        [data-bs-theme="dark"] .sup-toc__link:hover, [data-bs-theme="dark"] .sup-toc__link.active { background: rgba(255,255,255,.07); color: inherit; }
        .sup-toc__link i { width: 1.15rem; text-align: center; color: var(--secondary-color); }
        .sup-toc__link.active i { color: #0f766e; }
        .sup-toc__badge { margin-left: auto; font-size: .7rem; background: rgba(148,163,184,.25); border-radius: 999px; padding: 0 .45rem; }

        /* ── Animation d'apparition au défilement ── */
        .sup-reveal { opacity: 0; transform: translateY(14px); transition: opacity .5s ease, transform .5s ease; }
        .sup-reveal.is-visible { opacity: 1; transform: none; }
        @media (prefers-reduced-motion: reduce) { .sup-reveal { opacity: 1; transform: none; transition: none; } }

        .sup-footer { border-top: 1px solid rgba(148,163,184,.3); margin-top: 2.5rem; padding: 1.25rem 0;
                      font-size: .85rem; color: var(--secondary-color); }
        .sup-toc-toggle { display: none; }
        @media (max-width: 991.98px) { .sup-toc-toggle { display: inline-block; } }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

{% set current_route = app.request.attributes.get('_route') ?? '' %}

<header class="sup-topbar">
    <div class="sup-topbar__inner">
        <a href="{{ path('app_support') }}" class="sup-topbar__brand">
            <img src="{{ asset('images/logo-edu-school.png') }}" alt="EDU-SCHOOL">
            <span>EDU-SCHOOL<small>Centre d'aide</small></span>
        </a>

        <div class="sup-search">
            <i class="fas fa-magnifying-glass"></i>
            <input type="search" id="supSearch" placeholder="Rechercher une tâche…" autocomplete="off"
                   aria-label="Rechercher dans l'aide">
        </div>

        <div class="sup-topbar__actions">
            <button type="button" class="sup-topbar__btn sup-toc-toggle" data-bs-toggle="collapse"
                    data-bs-target="#supToc" aria-label="Afficher les modules"><i class="fas fa-list"></i></button>
            <button type="button" class="sup-topbar__btn" id="supThemeToggle" aria-label="Basculer le thème"><i class="fas fa-moon"></i></button>
            <a href="{{ path('app_documentation') }}" class="sup-topbar__btn"><i class="fas fa-book me-1"></i>Documentation</a>
        </div>
    </div>
</header>

<main class="sup-shell">
    {% block support_body %}{% endblock %}

    <footer class="sup-footer">
        &copy; {{ "now"|date("Y") }} EDU-SCHOOL — Système de Gestion Scolaire · Centre d'aide
    </footer>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Thème clair/sombre, clé partagée avec l'application.
    (function () {
        var root = document.documentElement, toggle = document.getElementById('supThemeToggle'), icon = toggle.querySelector('i');
        function apply(t) { root.setAttribute('data-bs-theme', t); icon.className = t === 'dark' ? 'fas fa-sun' : 'fas fa-moon'; }
        apply(localStorage.getItem('edu-school-theme') || 'light');
        toggle.addEventListener('click', function () {
            var next = root.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
            localStorage.setItem('edu-school-theme', next); apply(next);
        });
    })();

    // Apparition progressive des blocs au défilement.
    (function () {
        var items = document.querySelectorAll('.sup-reveal');
        if (!('IntersectionObserver' in window) || !items.length) {
            items.forEach(function (el) { el.classList.add('is-visible'); });
            return;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } });
        }, { threshold: .12 });
        items.forEach(function (el) { io.observe(el); });
    })();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
