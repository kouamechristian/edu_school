{% extends 'eleve/base.html.twig' %}

{% block title %}Mon profil{% endblock %}
{% block page_title %}Mon profil{% endblock %}
{% block page_subtitle %}Mes informations personnelles et scolaires.{% endblock %}

{% block body %}
<div class="pp-grid cols-2" style="align-items:start;">
    <section class="pp-card pp-reveal">
        <div class="pp-card-title" style="margin-bottom:1rem;"><i class="fas fa-user"></i> Identité</div>
        <div class="info-list">
            <div class="info-row"><div class="info-label">Nom</div><div class="info-value">{{ student.lastName }}</div></div>
            <div class="info-row"><div class="info-label">Prénom</div><div class="info-value">{{ student.firstName }}</div></div>
            <div class="info-row"><div class="info-label">Matricule national</div><div class="info-value">{{ student.matriculeNational ?: '—' }}</div></div>
            <div class="info-row"><div class="info-label">Date de naissance</div><div class="info-value">{{ student.dateOfBirth ? student.dateOfBirth|date('d/m/Y') : '—' }}</div></div>
            <div class="info-row"><div class="info-label">Lieu de naissance</div><div class="info-value">{{ student.placeOfBirth ?: '—' }}</div></div>
            <div class="info-row"><div class="info-label">Sexe</div><div class="info-value">{{ student.gender == 'M' ? 'Masculin' : (student.gender == 'F' ? 'Féminin' : '—') }}</div></div>
        </div>
    </section>

    <section class="pp-card pp-reveal">
        <div class="pp-card-title" style="margin-bottom:1rem;"><i class="fas fa-school"></i> Scolarité</div>
        <div class="info-list">
            <div class="info-row"><div class="info-label">Établissement</div><div class="info-value">{{ student.school ? student.school.name : '—' }}</div></div>
            <div class="info-row"><div class="info-label">Classe</div><div class="info-value">{{ student.classroom ? student.classroom.name : '—' }}</div></div>
            <div class="info-row"><div class="info-label">Année scolaire</div><div class="info-value">{{ student.schoolYear ? student.schoolYear.name : '—' }}</div></div>
        </div>
    </section>
</div>

<section class="pp-card pp-reveal" style="margin-top:1.1rem;">
    <div class="pp-card-title" style="margin-bottom:1rem;"><i class="fas fa-user-friends"></i> Parents / Tuteur</div>
    <div class="pp-grid cols-2" style="align-items:start;">
        <div class="info-list">
            <div class="info-row"><div class="info-label">Père</div><div class="info-value">{{ student.fatherFullName ?: '—' }}</div></div>
            <div class="info-row"><div class="info-label">Contact père</div><div class="info-value">{{ student.fatherPhone ?: '—' }}</div></div>
        </div>
        <div class="info-list">
            <div class="info-row"><div class="info-label">Mère</div><div class="info-value">{{ student.motherFullName ?: '—' }}</div></div>
            <div class="info-row"><div class="info-label">Contact mère</div><div class="info-value">{{ student.motherPhone ?: '—' }}</div></div>
        </div>
    </div>
</section>

<style>
    .info-list { display:flex; flex-direction:column; }
    .info-row { display:flex; justify-content:space-between; gap:1rem; padding:.55rem 0; border-bottom:1px solid #f1f4f9; }
    .info-row:last-child { border-bottom:none; }
    .info-label { color:#8a97a8; font-size:.85rem; }
    .info-value { color:#1e3a5f; font-weight:600; text-align:right; }
</style>
{% endblock %}
