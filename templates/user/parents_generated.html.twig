{% extends 'base.html.twig' %}

{% block title %}Comptes parents générés{% endblock %}

{% block stylesheets %}
<style>
    .credential { font-family: monospace; font-size: 1rem; letter-spacing: .03em; }
    .print-only { display: none; }
    @media print {
        .sidebar, .sidebar-overlay, .topbar, .no-print, .page-header__actions { display: none !important; }
        .content-wrapper { margin: 0 !important; padding: 0 !important; }
        .print-only { display: block; }
        .card { border: none !important; box-shadow: none !important; }
        table { font-size: 11pt; }
        tr { page-break-inside: avoid; }
    }
</style>
{% endblock %}

{% block body %}
<div class="container-fluid">
    {% embed 'components/page_header.html.twig' with {
        title: 'Comptes parents générés',
        subtitle: school.name ~ ' — ' ~ generated_at|date('d/m/Y H:i'),
        icon: 'fa-user-plus',
        color: 'primary',
        breadcrumb: [ { label: 'Administration' }, { label: 'Comptes Parents', path: path('admin_user_parents') }, { label: 'Génération' } ]
    } %}
        {% block actions %}
            <button type="button" class="btn btn-primary" onclick="window.print()"><i class="fas fa-print me-1"></i>Imprimer</button>
            <a href="{{ path('admin_user_parents') }}" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-1"></i>Retour</a>
        {% endblock %}
    {% endembed %}

    <div class="print-only mb-3">
        <h4 class="mb-0">{{ school.name }} — Identifiants des comptes parents</h4>
        <small>Générés le {{ generated_at|date('d/m/Y à H:i') }}</small>
    </div>

    <div class="row g-3 mb-3 no-print">
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Comptes créés</div><div class="fs-4 fw-bold text-success">{{ result.created|length }}</div></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Rattachés à un compte existant</div><div class="fs-4 fw-bold text-primary">{{ result.linked|length }}</div></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Élèves ignorés</div><div class="fs-4 fw-bold text-warning">{{ result.skipped|length }}</div></div></div></div>
        <div class="col-md-3"><div class="card"><div class="card-body"><div class="text-muted small">Élèves restant à traiter</div><div class="fs-4 fw-bold">{{ result.remaining }}</div></div></div></div>
    </div>

    {% if result.created is not empty %}
        <div class="alert alert-warning no-print">
            <i class="fas fa-exclamation-triangle me-1"></i>
            <strong>Les mots de passe ne sont affichés qu'une seule fois.</strong>
            Imprimez cette page avant de la quitter. Chaque parent devra changer son mot de passe à sa première connexion.
        </div>
    {% endif %}

    {% if result.remaining > 0 %}
        <div class="alert alert-info no-print">
            <i class="fas fa-info-circle me-1"></i>
            {{ result.remaining }} élève(s) restent à traiter (limite de {{ constant('App\\Service\\ParentAccountGenerator::BATCH_LIMIT') }} comptes par génération).
            Imprimez cette liste, puis relancez la génération depuis la page <a href="{{ path('admin_user_parents') }}">Comptes Parents</a>.
        </div>
    {% endif %}

    {% if result.created is not empty %}
    <div class="card table-card mb-3">
        <div class="card-header"><h6 class="m-0 fw-bold text-primary"><i class="fas fa-key me-2"></i>Nouveaux comptes</h6></div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Parent</th>
                            <th>Téléphone</th>
                            <th>Enfant(s)</th>
                            <th>Identifiant</th>
                            <th>Mot de passe</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in result.created %}
                        <tr>
                            <td class="fw-semibold">{{ row.parent.lastName }} {{ row.parent.firstName }}</td>
                            <td>{{ row.parent.phone ?: '—' }}</td>
                            <td>
                                {% for child in row.children %}
                                    <div>{{ child.lastName }} {{ child.firstName }}{% if child.classroom %} <small class="text-muted">({{ child.classroom.name }})</small>{% endif %}</div>
                                {% endfor %}
                            </td>
                            <td class="credential">{{ row.parent.username }}</td>
                            <td class="credential fw-bold">{{ row.password }}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}

    {% if result.linked is not empty %}
    <div class="card table-card mb-3">
        <div class="card-header"><h6 class="m-0 fw-bold text-primary"><i class="fas fa-link me-2"></i>Enfants rattachés à un compte parent existant</h6></div>
        <div class="card-body">
            <p class="text-muted small">Ces parents avaient déjà un compte (même nom, prénom et téléphone) : leur mot de passe n'a pas été modifié.</p>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0">
                    <thead><tr><th>Parent</th><th>Identifiant</th><th>Enfant(s) rattaché(s)</th></tr></thead>
                    <tbody>
                        {% for row in result.linked %}
                        <tr>
                            <td class="fw-semibold">{{ row.parent.lastName }} {{ row.parent.firstName }}</td>
                            <td class="credential">{{ row.parent.username }}</td>
                            <td>{% for child in row.children %}<div>{{ child.lastName }} {{ child.firstName }}</div>{% endfor %}</td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}

    {% if result.skipped is not empty %}
    <div class="card table-card mb-3 no-print">
        <div class="card-header"><h6 class="m-0 fw-bold text-warning"><i class="fas fa-user-times me-2"></i>Élèves ignorés</h6></div>
        <div class="card-body">
            <p class="text-muted small">Complétez la fiche de ces élèves (nom et prénom du parent détenant l'autorité parentale), puis relancez la génération.</p>
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead><tr><th>Élève</th><th>Autorité parentale</th><th>Motif</th><th></th></tr></thead>
                    <tbody>
                        {% for row in result.skipped %}
                        <tr>
                            <td>{{ row.student.lastName }} {{ row.student.firstName }}</td>
                            <td>{{ row.student.parentalAuthorityLabel }}</td>
                            <td>{{ row.reason }}</td>
                            <td class="text-end"><a href="{{ path('admin_student_edit', {'id': row.student.id}) }}" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a></td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% endif %}

    {% if result.created is empty and result.linked is empty and result.skipped is empty %}
        <div class="alert alert-info">Aucun élève éligible : tous les élèves dont l'autorité parentale est renseignée ont déjà un compte parent.</div>
    {% endif %}
</div>
{% endblock %}
