{% extends 'enseignant/base.html.twig' %}

{% block title %}Mes exercices{% endblock %}
{% block page_title %}Mes exercices de maison{% endblock %}
{% block page_subtitle %}Les exercices que vous avez publiés à vos classes.{% endblock %}

{% block body %}
<div style="display:flex;justify-content:flex-end;margin-bottom:1rem;">
    <a href="{{ path('enseignant_homework_new') }}" class="pp-btn pp-btn-primary"><i class="fas fa-plus"></i> Nouvel exercice</a>
</div>

{% if homeworks is empty %}
    <div class="pp-card pp-reveal">
        <div class="pp-empty"><i class="fas fa-inbox"></i><p>Vous n'avez encore publié aucun exercice.</p></div>
    </div>
{% else %}
    <section class="pp-card pp-reveal" style="padding:0;overflow:hidden;">
        <table class="pp-table">
            <thead>
                <tr><th>Titre</th><th>Classe</th><th>Matière</th><th class="text-center">Remise</th><th class="text-center">PJ</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                {% for hw in homeworks %}
                    <tr>
                        <td><strong>{{ hw.title }}</strong></td>
                        <td>{{ hw.classroom ? hw.classroom.name : '—' }}</td>
                        <td>{{ hw.subject ? hw.subject.name : '—' }}</td>
                        <td class="text-center"><span class="pp-badge {{ hw.upcoming ? 'green' : 'red' }}">{{ hw.dueDate|date('d/m/Y') }}</span></td>
                        <td class="text-center">{{ hw.hasAttachment ? '📎' : '—' }}</td>
                        <td class="text-end" style="white-space:nowrap;">
                            <a href="{{ path('enseignant_homework_show', {id: hw.id}) }}" class="pp-btn pp-btn-ghost" title="Consulter"><i class="fas fa-eye"></i></a>
                            <a href="{{ path('enseignant_homework_edit', {id: hw.id}) }}" class="pp-btn pp-btn-ghost" title="Modifier"><i class="fas fa-pen"></i></a>
                            <form method="post" action="{{ path('enseignant_homework_delete', {id: hw.id}) }}" style="display:inline;" onsubmit="return confirm('Supprimer cet exercice ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_homework_' ~ hw.id) }}">
                                <button type="submit" class="pp-btn pp-btn-ghost" title="Supprimer" style="color:#ef4444;"><i class="fas fa-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </section>
{% endif %}
{% endblock %}
