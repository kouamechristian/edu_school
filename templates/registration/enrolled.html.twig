{% extends 'base.html.twig' %}

{% block title %}Inscrits{% endblock %}

{% block body %}
<div class="container-fluid">
    {# ── En-tête ── #}
    {% embed 'components/page_header.html.twig' with {
        title: 'Inscrits',
        subtitle: 'Tous les élèves inscrits pour l\'année' ~ (current_school_year ? ' ' ~ current_school_year.name : ''),
        icon: 'fa-user-graduate',
        color: 'primary',
        breadcrumb: [ { label: 'Élèves' }, { label: 'Inscrits' } ]
    } %}
        {% block actions %}
            <a href="{{ path('admin_registration_enrolled_export') }}" class="btn btn-outline-success"><i class="fas fa-file-excel me-1"></i> Exporter Excel</a>
            <a href="{{ path('admin_registration_index') }}" class="btn btn-success"><i class="fas fa-graduation-cap me-1"></i> Affectation en classe</a>
        {% endblock %}
    {% endembed %}
    
    
    {# ── Statistiques (réservées au fondateur) ── #}
    {% if is_granted('ROLE_FONDATEUR') %}
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-6">
            <div class="stat-card primary h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Inscrits</div><div class="stat-value">{{ total_count }}</div></div>
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card info h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Montant total</div><div class="stat-value fs-5">{{ totals.tuition|number_format(0, ',', ' ') }}</div>
                        {% if totals.discount > 0 %}<small class="text-success"><i class="fas fa-tag me-1"></i>après {{ totals.discount|number_format(0, ',', ' ') }} de remises</small>{% endif %}</div>
                    <div class="stat-icon"><i class="fas fa-coins"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card success h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Payé</div><div class="stat-value fs-5">{{ totals.paid|number_format(0, ',', ' ') }}</div></div>
                    <div class="stat-icon"><i class="fas fa-circle-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card warning h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Restant</div><div class="stat-value fs-5">{{ totals.remaining|number_format(0, ',', ' ') }}</div></div>
                    <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Liste des inscrits ── #}
    <div class="card table-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h6 class="m-0 fw-bold text-primary"><i class="fas fa-list me-2"></i>Liste des inscrits{{ current_school_year ? ' — ' ~ current_school_year.name : '' }}</h6>
            {% if is_granted('ROLE_SUPER_ADMIN') %}
            <form method="post" action="{{ path('admin_registration_bulk_delete') }}" id="bulkDeleteRegistrations" class="d-none no-print"
                  data-bulk-delete data-bulk-label="inscription(s)"
                  data-bulk-warning="Leurs frais de l'année et les paiements associés (avec les écritures comptables) seront supprimés. Les élèves et leurs préinscriptions sont conservés.">
                <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_registrations') }}">
                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash me-1"></i> Supprimer la sélection (<span data-bulk-count>0</span>)</button>
            </form>
            {% endif %}
        </div>
        <div class="card-body">
            {# Recherche en base sur tous les inscrits de l'année #}
            <div class="mb-3 no-print">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" id="enrSearch" name="search" value="{{ search }}" class="form-control" placeholder="Rechercher (nom, matricule, classe)…" autocomplete="off" data-live-search="#enrResults">
                    <button type="button" class="btn btn-light" data-live-search-clear="#enrSearch" title="Effacer"><i class="fas fa-times"></i></button>
                </div>
            </div>
            <div id="enrResults">
            <div class="table-responsive">
                <table class="table table-hover align-middle" id="enrTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <th class="no-print" style="width:1%"><input type="checkbox" class="form-check-input" data-bulk-check-all="bulkDeleteRegistrations" title="Tout sélectionner"></th>
                            {% endif %}
                            <th>Mle interne</th>
                            <th>Mle national</th>
                            <th>Élève</th>
                            <th>Classe</th>
                            <th class="text-end">Remise</th>
                            <th class="text-end">Montant total</th>
                            <th class="text-end">Payé</th>
                            <th class="text-end">Annulé</th>
                            <th class="text-end">Restant/reporté</th>
                            <th class="text-center">Statut</th>
                            <th class="text-end no-print" width="100">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for r in registrations %}
                        <tr class="js-enrolled-row">
                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                            <td class="no-print"><input type="checkbox" class="form-check-input js-bulk-check" name="ids[]" value="{{ r.id }}" form="bulkDeleteRegistrations"></td>
                            {% endif %}
                            <td><span class="fw-semibold text-primary">{{ r.student.matriculeInterne ?: '—' }}</span></td>
                             <td><span class="fw-semibold text-primary">{{ r.student.matriculeNational ?: '—' }}</span></td>
                            <td class="fw-semibold">{{ r.student.lastName }} {{ r.student.firstName }}</td>
                            <td>{{ r.classroom ? r.classroom.name : '—' }}</td>
                            <td class="text-end text-nowrap">
                                {% if r.totalDiscount > 0 %}
                                    <span class="text-success fw-semibold" title="{{ r.discountReason ? 'Motif : ' ~ r.discountReason : '' }}">− {{ r.totalDiscount|number_format(0, ',', ' ') }}</span>
                                    {% if r.hasDiscount %}<br><span class="badge bg-success-subtle text-success">{{ r.discountLabel }}</span>{% endif %}
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                            <td class="text-end">{{ r.totalTuition|number_format(0, ',', ' ') }}</td>
                            <td class="text-end text-success">{{ r.totalPaid|number_format(0, ',', ' ') }}</td>
                            <td class="text-end text-danger">{{ r.totalCancelled|number_format(0, ',', ' ') }}</td>
                            <td class="text-end fw-semibold">{{ r.remainingTuition|number_format(0, ',', ' ') }}</td>
                            <td class="text-center"><span class="badge bg-{{ r.student.getStatusColor() }}">{{ r.student.getStatusLabel() }}</span></td>
                            <td class="text-end no-print">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('admin_student_show', {'id': r.student.id}) }}" class="btn btn-outline-info" title="Voir l'élève"><i class="fas fa-eye"></i></a>
                                    <a href="{{ path('admin_registration_edit', {'id': r.id}) }}" class="btn btn-outline-primary" title="Modifier l'inscription"><i class="fas fa-edit"></i></a>
                                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <form method="post" action="{{ path('admin_registration_bulk_delete') }}" class="d-inline"
                                          onsubmit="return confirm('Supprimer définitivement l\'inscription de {{ (r.student.lastName ~ ' ' ~ r.student.firstName)|e('js') }} ?\n\nSes frais de l\'année et les paiements associés seront supprimés. Cette action est irréversible.')">
                                        <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_registrations') }}">
                                        <input type="hidden" name="ids[]" value="{{ r.id }}">
                                        <button type="submit" class="btn btn-danger" title="Supprimer définitivement"><i class="fas fa-trash"></i></button>
                                    </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% else %}
                        <tr>
                            <td colspan="12">
                                {% from 'components/macros.html.twig' import empty_state %}
                                {{ search ? empty_state('fa-user-slash', 'Aucun résultat', 'Aucun inscrit ne correspond à « ' ~ search ~ ' ».') : empty_state('fa-user-slash', 'Aucun inscrit', 'Aucun élève n\'est inscrit pour l\'année scolaire courante.') }}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                    
                </table>
            </div>
            {% include '_pagination.html.twig' with { pagination: registrations } %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
