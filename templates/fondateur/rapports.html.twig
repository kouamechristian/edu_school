{% extends 'base.html.twig' %}
{% from 'components/macros.html.twig' import empty_state %}

{% block title %}Rapports{% endblock %}

{% block body %}
<div class="container-fluid">
    {% embed 'components/page_header.html.twig' with {
        title: 'Rapports',
        subtitle: group ? group.name : 'Inscriptions et paiements',
        icon: 'fa-chart-column',
        color: 'primary',
        breadcrumb: [ { label: 'Espace Fondateur', path: path('fondateur_index') }, { label: 'Rapports' } ]
    } %}{% endembed %}

    {% include '_flash.html.twig' %}

    {% if group is null %}
        <div class="alert alert-warning">
            <i class="fas fa-triangle-exclamation me-2"></i>
            Aucun groupe d'établissements n'est rattaché à votre compte. Les rapports ne peuvent pas être calculés.
        </div>
    {% endif %}

    {# ── Filtre de période ── #}
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small">Du</label>
                    <input type="date" name="debut" value="{{ start_date|date('Y-m-d') }}" class="form-control">
                </div>
                <div class="col-md-3">
                    <label class="form-label small">Au</label>
                    <input type="date" name="fin" value="{{ end_date|date('Y-m-d') }}" class="form-control">
                </div>
                <div class="col-md-3 d-grid">
                    <button class="btn btn-primary"><i class="fas fa-filter me-1"></i> Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4 mb-2">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-left-success">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-success fw-bold small mb-1">Élèves inscrits</div>
                        <div class="h4 mb-0 text-gray-800">{{ registrations|length }}</div>
                        <small class="text-muted">du {{ start_date|date('d/m/Y') }} au {{ end_date|date('d/m/Y') }}</small>
                    </div>
                    <i class="fas fa-user-graduate fa-2x text-gray-300"></i>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-left-primary">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-uppercase text-primary fw-bold small mb-1">Paiements effectués</div>
                        <div class="h4 mb-0 text-gray-800">{{ payments|length }} <small class="text-muted fs-6">({{ payments_total|number_format(0, ',', ' ') }} F)</small></div>
                        <small class="text-muted">du {{ start_date|date('d/m/Y') }} au {{ end_date|date('d/m/Y') }}</small>
                    </div>
                    <i class="fas fa-sack-dollar fa-2x text-gray-300"></i>
                </div>
            </div>
        </div>
    </div>

    {# ============================================================
       ÉLÈVES INSCRITS
       ============================================================ #}
    <h5 class="mt-4 mb-3"><i class="fas fa-user-graduate text-success me-2"></i>Élèves inscrits par jour</h5>
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th class="text-end">Nombre d'inscrits</th>
                    </tr>
                </thead>
                <tbody>
                    {% for day, items in registrations_by_day %}
                        <tr>
                            <td class="fw-semibold">{{ day != 'inconnu' ? day|date('d/m/Y') : 'Date inconnue' }}</td>
                            <td class="text-end"><span class="badge bg-success-subtle text-success">{{ items|length }}</span></td>
                        </tr>
                    {% else %}
                        <tr><td colspan="2">{{ empty_state('fa-user-graduate', 'Aucune inscription', "Aucun élève n'a été inscrit sur cette période.") }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if registrations is not empty %}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fas fa-list text-success me-2"></i>
            <span class="fw-bold">Liste des élèves inscrits</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date d'inscription</th>
                        <th>Élève</th>
                        <th>Matricule</th>
                        <th>Établissement</th>
                        <th>Classe</th>
                        <th>Type</th>
                    </tr>
                </thead>
                <tbody>
                    {% for registration in registrations %}
                        {% set student = registration.student %}
                        <tr>
                            <td class="text-muted">{{ registration.enrolledAt ? registration.enrolledAt|date('d/m/Y') : '—' }}</td>
                            <td class="fw-semibold">{{ student ? student.fullName : '—' }}</td>
                            <td>{{ student ? (student.matriculeInterne ?: '—') : '—' }}</td>
                            <td>{{ registration.school ? registration.school.name : '—' }}</td>
                            <td>{{ registration.classroom ? registration.classroom.name : '—' }}</td>
                            <td>
                                {% if registration.repeating %}
                                    <span class="badge badge-soft warning">Redoublant</span>
                                {% else %}
                                    <span class="badge badge-soft primary">Nouvelle inscription</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}

    {# ============================================================
       PAIEMENTS EFFECTUÉS
       ============================================================ #}
    <h5 class="mt-4 mb-3"><i class="fas fa-sack-dollar text-primary me-2"></i>Paiements effectués par jour</h5>
    <div class="card shadow-sm mb-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th class="text-end">Nombre de paiements</th>
                        <th class="text-end">Montant total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for day, data in payments_by_day %}
                        <tr>
                            <td class="fw-semibold">{{ day != 'inconnu' ? day|date('d/m/Y') : 'Date inconnue' }}</td>
                            <td class="text-end"><span class="badge bg-primary-subtle text-primary">{{ data.items|length }}</span></td>
                            <td class="text-end fw-bold">{{ data.total|number_format(0, ',', ' ') }} F</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="3">{{ empty_state('fa-sack-dollar', 'Aucun paiement', "Aucun paiement n'a été effectué sur cette période.") }}</td></tr>
                    {% endfor %}
                </tbody>
                {% if payments_by_day is not empty %}
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <td>Total</td>
                        <td class="text-end">{{ payments|length }}</td>
                        <td class="text-end">{{ payments_total|number_format(0, ',', ' ') }} F</td>
                    </tr>
                </tfoot>
                {% endif %}
            </table>
        </div>
    </div>

    {% if payments is not empty %}
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white d-flex align-items-center">
            <i class="fas fa-list text-primary me-2"></i>
            <span class="fw-bold">Liste des paiements</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Date</th>
                        <th>Reçu</th>
                        <th>Élève</th>
                        <th>Établissement</th>
                        <th>Frais imputés</th>
                        <th class="text-end">Montant</th>
                        <th>Mode</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    {% for payment in payments %}
                        <tr>
                            <td class="text-muted">{{ payment.date ? payment.date|date('d/m/Y') : '—' }}</td>
                            <td><span class="badge badge-soft secondary">{{ payment.receipt_number }}</span></td>
                            <td class="fw-semibold">{{ payment.student ? payment.student.fullName : '—' }}</td>
                            <td>{{ payment.school ? payment.school.name : '—' }}</td>
                            <td><small class="text-muted">{{ payment.fee_names|join(', ') ?: '—' }}</small></td>
                            <td class="text-end fw-bold">{{ payment.amount|number_format(0, ',', ' ') }} F</td>
                            <td>{{ payment.method_label }}</td>
                            <td><span class="badge bg-{{ payment.status_color }}">{{ payment.status_label }}</span></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    {% endif %}
</div>

<style>
.border-left-primary { border-left: 0.25rem solid #4e73df !important; }
.border-left-success { border-left: 0.25rem solid #1cc88a !important; }
</style>
{% endblock %}
