{% extends 'base.html.twig' %}
{% from 'components/macros.html.twig' import empty_state %}

{% block title %}Gestion des Paiements{% endblock %}

{% block body %}
<div class="container-fluid">
    {% embed 'components/page_header.html.twig' with {
        title: 'Gestion des Paiements',
        subtitle: current_school ? current_school.name : 'Encaissements et suivi',
        icon: 'fa-credit-card',
        color: 'primary',
        breadcrumb: [ { label: 'Paiements' } ]
    } %}
        {% block actions %}
            {% if current_school %}
                <a href="{{ path('admin_payment_export_pdf', app.request.query.all) }}" data-live-search-sync target="_blank" rel="noopener" class="btn btn-outline-danger"><i class="fas fa-file-pdf me-1"></i> PDF</a>
                {% if cash_register_open and cash_register_validated %}
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#importPaymentsModal"><i class="fas fa-file-import me-1"></i> Importer</button>
                {% else %}
                    <button type="button" class="btn btn-outline-primary disabled" aria-disabled="true" title="Caisse non disponible"><i class="fas fa-file-import me-1"></i> Importer</button>
                {% endif %}
                {% if cash_register_open and cash_register_validated %}
                    <a href="{{ path('admin_payment_new') }}" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Nouveau Paiement</a>
                {% else %}
                    <button type="button" class="btn btn-primary disabled" aria-disabled="true" title="Caisse non disponible"><i class="fas fa-plus me-1"></i> Nouveau Paiement</button>
                {% endif %}
            {% endif %}
        {% endblock %}
    {% endembed %}

    {% include '_flash.html.twig' %}

    {% if current_school and not cash_register_open %}
        <div class="alert alert-warning d-flex align-items-center">
            <i class="fas fa-triangle-exclamation me-2 fa-lg"></i>
            <div>
                Votre caisse n'est pas ouverte. Ouvrez votre caisse pour enregistrer des paiements.
                <a href="{{ path('admin_cash_register_open') }}" class="alert-link ms-1">Ouvrir ma caisse</a>
            </div>
        </div>
    {% elseif current_school and cash_register_open and not cash_register_validated %}
        <div class="alert alert-warning d-flex align-items-center">
            <i class="fas fa-lock me-2 fa-lg"></i>
            <div>
                Votre caisse n'a pas encore été validée par le fondateur. Aucun paiement n'est possible tant qu'elle n'est pas validée.
            </div>
        </div>
    {% endif %}

    {% if current_school %}
        {# ── Filtres ── #}
        <div class="card filter-card mb-4">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Recherche</label>
                        <input type="text" class="form-control" id="searchInput" name="search" placeholder="N° reçu, référence, élève, matricule…" value="{{ search_term }}" autocomplete="off" data-live-search="#payResults">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Statut</label>
                        <select class="form-select" id="statusFilter" name="status">
                            <option value="">Tous les statuts</option>
                            <option value="en_attente" {{ current_status == 'en_attente' ? 'selected' : '' }}>En attente</option>
                            <option value="payé" {{ current_status == 'payé' ? 'selected' : '' }}>Payé</option>
                            <option value="partiellement_payé" {{ current_status == 'partiellement_payé' ? 'selected' : '' }}>Partiellement payé</option>
                            <option value="annulé" {{ current_status == 'annulé' ? 'selected' : '' }}>Annulé</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Méthode</label>
                        <select class="form-select" id="methodFilter" name="method">
                            <option value="">Toutes méthodes</option>
                            <option value="espèces" {{ current_method == 'espèces' ? 'selected' : '' }}>Espèces</option>
                            <option value="chèque" {{ current_method == 'chèque' ? 'selected' : '' }}>Chèque</option>
                            <option value="virement" {{ current_method == 'virement' ? 'selected' : '' }}>Virement</option>
                            <option value="carte" {{ current_method == 'carte' ? 'selected' : '' }}>Carte</option>
                            <option value="mobile_money" {{ current_method == 'mobile_money' ? 'selected' : '' }}>Mobile Money</option>
                            <option value="ecobank" {{ current_method == 'ecobank' ? 'selected' : '' }}>ECOBANK</option>
                            <option value="bank" {{ current_method == 'bank' ? 'selected' : '' }}>BANK</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100"><i class="fas fa-filter me-1"></i> Filtrer</button>
                    </div>
                </form>
            </div>
        </div>

        {# ── Tableau ── #}
        <div class="card table-card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-list me-2"></i>Liste des paiements</h6>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                <form method="post" action="{{ path('admin_payment_bulk_delete') }}" id="bulkDeletePayments" class="d-none"
                      data-bulk-delete data-bulk-label="paiement(s)"
                      data-bulk-warning="Les montants seront retirés des frais des élèves et les écritures comptables supprimées.">
                    <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_payments') }}">
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash me-1"></i> Supprimer la sélection (<span data-bulk-count>0</span>)</button>
                </form>
                {% endif %}
            </div>
            <div class="card-body" id="payResults">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="paymentsTable">
                        <thead>
                            <tr>{% if is_granted('ROLE_SUPER_ADMIN') %}<th style="width:1%"><input type="checkbox" class="form-check-input" data-bulk-check-all="bulkDeletePayments" title="Tout sélectionner"></th>{% endif %}<th>N° Paiement</th><th>Élève</th><th class="text-end">Montant</th><th>Date</th><th>Méthode</th><th>Statut</th><th class="text-end">Actions</th></tr>
                        </thead>
                        <tbody>
                            {% for receipt in payments %}
                                {% set first_id = receipt.lines[0].id %}
                                {% set line_ids = receipt.lines|map(l => l.id)|join(',') %}
                                <tr class="js-payment-row {{ receipt.status == 'annulé' ? 'table-danger' : '' }}">
                                    {% if is_granted('ROLE_SUPER_ADMIN') %}
                                    <td><input type="checkbox" class="form-check-input js-bulk-check" name="ids[]" value="{{ line_ids }}" form="bulkDeletePayments"></td>
                                    {% endif %}
                                    <td>
                                        <span class="badge badge-soft secondary">{{ receipt.receipt_number }}</span>
                                        {% if receipt.lines|length > 1 %}<br><small class="text-muted">{{ receipt.lines|length }} frais imputés : {{ receipt.fee_names|join(', ') }}</small>{% endif %}
                                    </td>
                                    <td><strong>{{ receipt.student.fullName }}</strong><br><small class="text-muted">{{ receipt.student.matriculeInterne }}</small></td>
                                    <td class="text-end fw-bold">{{ receipt.amount|number_format(0, ',', ' ') }} FCFA</td>
                                    <td>
                                        <span class="{% if receipt.date and receipt.date >= date('-1 day') %}text-success{% else %}text-muted{% endif %}">{{ receipt.date ? receipt.date|date('d/m/Y') : '—' }}</span>
                                    </td>
                                    <td><span class="badge badge-soft secondary">{{ receipt.method_label }}</span></td>
                                    <td><span class="badge bg-{{ receipt.status_color }}">{{ receipt.status_label }}</span></td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a href="{{ path('admin_payment_show', {'id': first_id}) }}" class="btn btn-outline-info" title="Voir"><i class="fas fa-eye"></i></a>
                                            {% if receipt.status == 'payé' %}
                                                <a href="{{ path('admin_payment_receipt', {'id': first_id}) }}" target="_blank" rel="noopener" class="btn btn-outline-success" title="Reçu PDF"><i class="fas fa-file-pdf"></i></a>
                                            {% endif %}
                                            {% if receipt.status == 'en_attente' or receipt.status == 'partiellement_payé' %}
                                                <form method="post" action="{{ path('admin_payment_confirm', {'id': first_id}) }}" class="d-inline">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('confirm' ~ first_id) }}">
                                                    <button type="submit" class="btn btn-outline-success" title="Confirmer"><i class="fas fa-check"></i></button>
                                                </form>
                                                <form method="post" action="{{ path('admin_payment_cancel', {'id': first_id}) }}" class="d-inline"
                                                      data-confirm="Voulez-vous vraiment annuler le paiement <strong>{{ receipt.receipt_number }}</strong> de <strong>{{ receipt.amount|number_format(0, ',', ' ') }} FCFA</strong> de l'élève <strong>{{ receipt.student.fullName }}</strong> ?"
                                                      data-confirm-title="Annuler le paiement"
                                                      data-confirm-btn="Oui, annuler"
                                                      data-confirm-icon="warning">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ first_id) }}">
                                                    <button type="submit" class="btn btn-outline-danger" title="Annuler"><i class="fas fa-times"></i></button>
                                                </form>
                                            {% endif %}
                                            {% if receipt.status == 'payé' %}
                                            <form method="post" action="{{ path('admin_payment_cancel', {'id': first_id}) }}" class="d-inline"
                                                  data-confirm="Voulez-vous vraiment annuler le paiement <strong>{{ receipt.receipt_number }}</strong> de <strong>{{ receipt.amount|number_format(0, ',', ' ') }} FCFA</strong> de l'élève <strong>{{ receipt.student.fullName }}</strong> ?<br><small class='text-muted'>{{ receipt.lines|length > 1 ? 'Les ' ~ receipt.lines|length ~ ' frais imputés seront retirés du solde de l\'élève.' : 'Le montant sera retiré du frais de l\'élève.' }}</small>"
                                                  data-confirm-title="Annuler le paiement"
                                                  data-confirm-btn="Oui, annuler"
                                                  data-confirm-icon="warning">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ first_id) }}">
                                                <button type="submit" class="btn btn-outline-danger" title="Annuler le paiement"><i class="fas fa-ban"></i></button>
                                            </form>
                                            {% endif %}
                                            {% if is_granted('ROLE_SUPER_ADMIN') %}
                                            <form method="post" action="{{ path('admin_payment_bulk_delete') }}" class="d-inline"
                                                  onsubmit="return confirm('Supprimer définitivement le paiement {{ receipt.receipt_number|e('js') }} ({{ receipt.amount|number_format(0, ',', ' ') }} FCFA) ?\n\nLe montant sera retiré des frais de l\'élève et l\'écriture comptable supprimée. Cette action est irréversible.')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('bulk_delete_payments') }}">
                                                <input type="hidden" name="ids[]" value="{{ line_ids }}">
                                                <button type="submit" class="btn btn-danger" title="Supprimer définitivement"><i class="fas fa-trash"></i></button>
                                            </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="8">{{ empty_state('fa-credit-card', 'Aucun paiement', 'Aucun paiement ne correspond à vos critères.') }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% include '_pagination.html.twig' with { pagination: payments } %}
            </div>
        </div>
    {% else %}
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-school"></i></div>
            <h6>Sélectionnez un établissement</h6>
            <p>Veuillez sélectionner un établissement pour voir les paiements.</p>
            <a href="{{ path('admin_school_index') }}" class="btn btn-primary"><i class="fas fa-school me-1"></i> Gérer les Établissements</a>
        </div>
    {% endif %}

    {# ── Import de paiements ── #}
    {% if current_school %}
    <div class="modal fade" id="importPaymentsModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post" action="{{ path('admin_payment_import') }}" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="fas fa-file-import me-2 text-primary"></i>Importer des paiements</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-2">
                            Fichier <strong>.xlsx</strong>, <strong>.xls</strong> ou <strong>.csv</strong> : une ligne par versement.
                            Colonnes obligatoires : <strong>Matricule</strong> (interne ou national), <strong>Montant</strong> et
                            <strong>Date de paiement</strong>. Facultatives : Méthode (Espèces par défaut), Référence, Frais, Notes.
                        </p>
                        <p class="text-muted small mb-2">
                            Sans frais indiqué, le montant est réparti comme au guichet : arriérés d'abord, puis par échéance.
                            Un montant supérieur au reste dû est refusé, et les paiements déjà enregistrés sont ignorés.
                        </p>
                        <p class="text-muted small">
                            <i class="fas fa-eye me-1"></i>Un <strong>aperçu</strong> s'affiche avant tout enregistrement.
                            Les paiements importés sont rattachés à votre caisse ouverte.
                        </p>
                        <div class="mb-3">
                            <a href="{{ path('admin_payment_import_template') }}" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-download me-1"></i> Télécharger le modèle
                            </a>
                        </div>
                        <label for="importPaymentsFile" class="form-label">Fichier à importer</label>
                        <input type="file" class="form-control" id="importPaymentsFile" name="file" accept=".xlsx,.xls,.csv" required>
                        <input type="hidden" name="_token" value="{{ csrf_token('import_payments') }}">
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-primary"><i class="fas fa-eye me-1"></i> Analyser le fichier</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    {% endif %}
</div>

{% endblock %}
