{% extends 'base.html.twig' %}

{% block title %}Nouveau Paiement{% endblock %}

{% block body %}
<div class="container-fluid">
    {% embed 'components/page_header.html.twig' with {
        title: 'Nouveau Paiement',
        icon: 'fa-credit-card',
        color: 'primary',
        breadcrumb: [
            { label: 'Paiements', path: path('admin_payment_index') },
            { label: 'Nouveau' }
        ]
    } %}
        {% block actions %}
            <a href="{{ path('admin_payment_index') }}" class="btn btn-light"><i class="fas fa-arrow-left me-1"></i> Retour</a>
        {% endblock %}
    {% endembed %}

    {% include '_flash.html.twig' %}
    {% include 'payment/_steps.html.twig' with { step: 1 } %}

    <div class="row">
        <div class="col-lg-8 mb-3">
            <div class="card">
                <div class="card-header"><h6 class="m-0 fw-bold text-primary"><i class="fas fa-user-graduate me-2"></i>Élève et montant versé par le parent</h6></div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'id': 'paymentStartForm'}}) }}
                        <div class="mb-3">
                            {{ form_row(form.student) }}
                            <div class="mt-2" id="studentSummary" data-summary-url="{{ path('admin_payment_student_summary', {id: 0}) }}" style="display:none;">
                                <div class="card card-accent success mb-0">
                                    <div class="card-body py-2">
                                        <div class="row g-2 small">
                                            <div class="col-md-6"><strong>Nom</strong> : <span data-field="nom">—</span></div>
                                            <div class="col-md-6"><strong>Prénom</strong> : <span data-field="prenom">—</span></div>
                                            <div class="col-md-6"><strong>Classe</strong> : <span data-field="classe">—</span></div>
                                            <div class="col-md-6"><strong>Montant scolarité</strong> : <span data-field="montantScolarite">—</span></div>
                                            <div class="col-md-6"><strong>Montant payé</strong> : <span data-field="montantPaye">—</span></div>
                                            <div class="col-md-6"><strong>Reste à payer</strong> : <span data-field="maxPayable" class="fw-bold text-danger">—</span></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div id="arriereWarning" class="alert alert-warning py-2 mt-2 mb-0 small" style="display:none;"></div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3" id="amount-wrap">
                                {{ form_row(form.amount) }}
                                <div class="small mt-1" id="amountHint"></div>
                            </div>
                            <div class="col-md-4 mb-3">{{ form_row(form.paymentDate) }}</div>
                            <div class="col-md-4 mb-3">{{ form_row(form.paymentMethod) }}</div>
                        </div>

                        <div class="mb-3">{{ form_row(form.notes) }}</div>

                        <div class="pt-3 border-top d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary" id="continueBtn">
                                Continuer vers l'imputation <i class="fas fa-arrow-right ms-1"></i>
                            </button>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="card card-accent info">
                <div class="card-header"><h6 class="m-0 fw-bold"><i class="fas fa-circle-info me-2"></i>Comment ça marche</h6></div>
                <div class="card-body small">
                    <ol class="ps-3 mb-0">
                        <li class="mb-2">Sélectionnez l'élève et saisissez le <strong>montant remis par le parent</strong>.</li>
                        <li class="mb-2">Sur la page suivante, <strong>répartissez ce montant</strong> sur les frais de votre choix.</li>
                        <li>Dès que la somme des imputations est égale au montant versé, validez : <strong>le reçu s'affiche</strong>.</li>
                    </ol>
                    <div class="text-muted mt-3"><i class="fas fa-hashtag me-1"></i>La référence et le numéro de reçu sont générés automatiquement.</div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var el = document.querySelector('.js-student-select');
            var amountInput = document.querySelector('#amount-wrap input');
            var hint = document.getElementById('amountHint');
            var box = document.getElementById('studentSummary');
            var warn = document.getElementById('arriereWarning');
            if (!el) return;

            var maxPayable = null;

            function formatMoneyXof(value) {
                if (value === null || value === undefined || value === '') return '—';
                var n = Number(value);
                if (Number.isNaN(n)) return String(value);
                return n.toLocaleString('fr-FR', { maximumFractionDigits: 0 }) + ' F CFA';
            }

            function setField(name, value) {
                var node = box.querySelector('[data-field="' + name + '"]');
                if (node) node.textContent = value;
            }

            // Plafond du montant versé : le reste à payer de l'élève.
            function updateAmountHint() {
                if (!hint) return;
                if (maxPayable === null) { hint.textContent = ''; hint.className = 'small mt-1'; return; }
                var amount = parseFloat(amountInput ? amountInput.value : '') || 0;
                if (amount > maxPayable + 0.009) {
                    hint.className = 'small mt-1 text-danger fw-bold';
                    hint.textContent = 'Le montant dépasse le reste à payer (' + formatMoneyXof(maxPayable) + ').';
                } else {
                    hint.className = 'small mt-1 text-muted';
                    hint.textContent = 'Maximum : ' + formatMoneyXof(maxPayable);
                }
            }

            async function loadStudentSummary(studentId) {
                maxPayable = null;
                warn.style.display = 'none';
                if (!studentId) { box.style.display = 'none'; updateAmountHint(); return; }

                var url = (box.getAttribute('data-summary-url') || '').replace('/0/', '/' + String(studentId) + '/');
                try {
                    var res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    var data = await res.json();

                    box.style.display = '';
                    setField('nom', data.nom ?? '—');
                    setField('prenom', data.prenom ?? '—');
                    setField('classe', data.classe ?? '—');
                    setField('montantScolarite', formatMoneyXof(data.montantScolarite));
                    setField('montantPaye', formatMoneyXof(data.montantPaye));
                    setField('maxPayable', formatMoneyXof(data.maxPayable));

                    maxPayable = Number(data.maxPayable) || 0;
                    if (amountInput) amountInput.setAttribute('max', Math.ceil(maxPayable));

                    // Un arriéré antérieur se solde en priorité avant la scolarité courante.
                    if (Number(data.arriereRemaining) > 0) {
                        warn.innerHTML = '<i class="fas fa-triangle-exclamation me-1"></i>Cet élève a un arriéré antérieur de <strong>'
                            + formatMoneyXof(data.arriereRemaining) + '</strong> à solder <strong>en priorité</strong> avant la scolarité courante.';
                        warn.style.display = '';
                    }
                } catch (e) {
                    box.style.display = 'none';
                    if (amountInput) amountInput.removeAttribute('max');
                }
                updateAmountHint();
            }

            // Le select élève est rendu recherchable par l'enhancer TomSelect global de
            // base.html.twig (qui déclenche l'événement « change » natif sur le select).
            el.addEventListener('change', function () { loadStudentSummary(el.value); });
            if (amountInput) amountInput.addEventListener('input', updateAmountHint);

            loadStudentSummary(el.value);
        });
    </script>
{% endblock %}
