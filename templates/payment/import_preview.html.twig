{% extends 'base.html.twig' %}

{% block title %}Import de paiements{% endblock %}

{% block body %}
<div class="container-fluid">
    {% embed 'components/page_header.html.twig' with {
        title: 'Import de paiements — aperçu',
        subtitle: file_name,
        icon: 'fa-file-import',
        color: 'primary',
        breadcrumb: [ { label: 'Paiements', path: path('admin_payment_index') }, { label: 'Import' } ]
    } %}
        {% block actions %}
            <a href="{{ path('admin_payment_index') }}" class="btn btn-light"><i class="fas fa-arrow-left me-1"></i> Annuler</a>
        {% endblock %}
    {% endembed %}

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="stat-card success h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Paiements à importer</div><div class="stat-value">{{ result.imported }}</div></div>
                    <div class="stat-icon"><i class="fas fa-check"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card primary h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Montant total</div><div class="stat-value">{{ result.total|number_format(0, ',', ' ') }} F</div></div>
                    <div class="stat-icon"><i class="fas fa-coins"></i></div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stat-card warning h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div><div class="stat-label mb-1">Lignes ignorées</div><div class="stat-value">{{ result.skipped }}</div></div>
                    <div class="stat-icon"><i class="fas fa-triangle-exclamation"></i></div>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info d-flex align-items-start">
        <i class="fas fa-circle-info me-2 mt-1"></i>
        <div>
            Rien n'est encore enregistré. À la confirmation, seules les lignes <strong>valides</strong> sont importées
            (statut « Payé », rattachées à votre caisse ouverte, écriture comptable automatique) ; les lignes ignorées restent à corriger dans le fichier.
        </div>
    </div>

    <div class="card table-card mb-4">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Ligne</th>
                            <th>Matricule</th>
                            <th>Élève</th>
                            <th class="text-end">Montant</th>
                            <th>Date</th>
                            <th>Méthode</th>
                            <th>Référence</th>
                            <th>Imputation / motif</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in result.rows %}
                        <tr class="{{ row.ok ? '' : 'table-warning' }}">
                            <td class="text-muted">{{ row.line }}</td>
                            <td>{{ row.matricule ?: '—' }}</td>
                            <td class="fw-semibold">{{ row.student ?: '—' }}</td>
                            <td class="text-end">{{ row.amount|number_format(0, ',', ' ') }}</td>
                            <td>{{ row.date ?: '—' }}</td>
                            <td>{{ row.method ?: '—' }}</td>
                            <td class="small">{{ row.reference ?: 'auto (IMP-…)' }}</td>
                            <td class="small">
                                {% if row.ok %}
                                    {% for a in row.allocations %}
                                        <div><i class="fas fa-check text-success me-1"></i>{{ a.name }} : {{ a.amount|number_format(0, ',', ' ') }} F</div>
                                    {% endfor %}
                                {% else %}
                                    <span class="text-danger"><i class="fas fa-xmark me-1"></i>{{ row.message }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        {% else %}
                        <tr><td colspan="8" class="text-center text-muted py-4">Aucune ligne de paiement dans le fichier.</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mb-4">
        <a href="{{ path('admin_payment_index') }}" class="btn btn-light">Annuler</a>
        {% if result.imported > 0 %}
            <form method="post" action="{{ path('admin_payment_import_confirm', {token: token}) }}"
                  onsubmit="return confirm('Importer {{ result.imported }} paiement(s) pour {{ result.total|number_format(0, ',', ' ') }} F CFA ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('import_payments_confirm_' ~ token) }}">
                <button type="submit" class="btn btn-success"><i class="fas fa-check me-1"></i> Confirmer l'import ({{ result.imported }})</button>
            </form>
        {% endif %}
    </div>
</div>
{% endblock %}
