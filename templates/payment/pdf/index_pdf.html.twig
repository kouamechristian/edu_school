<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <style>
        @page { margin: 22px 24px; }
        body { font-family: Helvetica, Arial, sans-serif; font-size: 9px; color: #000; }
        .header { width: 100%; border-bottom: 1px solid #999; padding-bottom: 6px; margin-bottom: 10px; }
        .header td { vertical-align: middle; }
        .header .logo { width: 74px; }
        .header .logo img { max-height: 60px; max-width: 68px; }
        .header .school { text-align: center; }
        .header .school .name { font-weight: bold; font-size: 14px; }
        .header .school .ministry { font-size: 9px; }
        .title-main { text-align: center; font-weight: bold; font-size: 13px; margin: 4px 0; }
        .period { text-align: center; font-size: 9px; margin-bottom: 10px; color: #333; }
        table.list { width: 100%; border-collapse: collapse; }
        table.list th, table.list td { border: 1px solid #000; padding: 3px 5px; font-size: 8.5px; }
        table.list th { background: #f2f2f2; font-weight: bold; text-align: left; }
        td.num { text-align: right; }
        td.center { text-align: center; }
        tr.tot td { font-weight: bold; background: #f7f7f7; }
    </style>
</head>
<body>
    <table class="header">
        <tr>
            <td class="logo">{% if logo_data %}<img src="{{ logo_data }}" alt="Logo">{% endif %}</td>
            <td class="school">
                <div class="name">{{ school ? school.name|upper : '' }}</div>
                <div class="ministry">{{ school ? school.sousTutelle : '' }}</div>
            </td>
            <td class="logo"></td>
        </tr>
    </table>

    <div class="title-main">LISTE DES PAIEMENTS</div>
    <div class="period">
        {% if search_term %}Recherche : « {{ search_term }} »{% elseif current_status %}Statut : {{ current_status }}{% elseif current_method %}Méthode : {{ current_method }}{% else %}Tous les paiements{% endif %}
        — édité le {{ generated_at|date('d/m/Y H:i') }}
    </div>

    <table class="list">
        <thead>
            <tr>
                <th style="width:16%">N° Paiement</th>
                <th>Élève</th>
                <th style="width:12%">Montant</th>
                <th style="width:10%">Date</th>
                <th style="width:12%">Méthode</th>
                <th style="width:12%">Statut</th>
            </tr>
        </thead>
        <tbody>
            {% for receipt in receipts %}
                <tr>
                    <td>{{ receipt.receipt_number }}{% if receipt.lines|length > 1 %}<br><span style="color:#666;">{{ receipt.lines|length }} frais imputés</span>{% endif %}</td>
                    <td>{{ receipt.student.fullName }} <span style="color:#666;">({{ receipt.student.matriculeInterne }})</span></td>
                    <td class="num">{{ receipt.amount|number_format(0, ',', ' ') }} F</td>
                    <td class="center">{{ receipt.date ? receipt.date|date('d/m/Y') : '—' }}</td>
                    <td class="center">{{ receipt.method_label }}</td>
                    <td class="center">{{ receipt.status_label }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="center">Aucun paiement.</td></tr>
            {% endfor %}
            {% if receipts|length > 0 %}
                <tr class="tot">
                    <td colspan="2" class="num">TOTAL ({{ receipts|length }})</td>
                    <td class="num">{{ total_amount|number_format(0, ',', ' ') }} F</td>
                    <td colspan="3"></td>
                </tr>
            {% endif %}
        </tbody>
    </table>
</body>
</html>
