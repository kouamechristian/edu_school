            <tr><td><code>Cycle</code>, <code>Level</code>, <code>Faculty</code>, <code>Round</code>, <code>Classroom</code></td><td>Structure pédagogique.</td></tr>
            <tr><td><code>Subject</code>, <code>SubjectType</code>, <code>Course</code>, <code>TimeSlot</code>, <code>Room</code></td><td>Matières et emplois du temps.</td></tr>
            <tr><td><code>Period</code>, <code>Evaluation</code>, <code>Grade</code></td><td>Périodes, évaluations et notes.</td></tr>
            <tr><td><code>Bulletin</code>, <code>BulletinLine</code></td><td>Bulletins scolaires.</td></tr>
            <tr><td><code>Absence</code>, <code>AbsenceType</code></td><td>Absences et assiduité.</td></tr>
            <tr><td><code>Fee</code>, <code>StudentFee</code>, <code>FeeSchedule</code></td><td>Frais du niveau, frais dus par l'élève, échéanciers.</td></tr>
            <tr><td><code>Payment</code>, <code>CashRegister</code>, <code>CashDeposit</code>, <code>Depense</code></td><td>Encaissements, caisses, versements bancaires, dépenses.</td></tr>
            <tr><td><code>AccountingAccount</code>, <code>AccountingEntry</code>, <code>AccountingPeriodClosure</code>, <code>BankReconciliation</code></td><td>Comptabilité.</td></tr>
            <tr><td><code>Employee</code>, <code>Contract</code>, <code>SalaryComponent</code>, <code>PayrollPeriod</code>, <code>Payslip</code></td><td>RH et paie.</td></tr>
            <tr><td><code>User</code></td><td>Compte de connexion et rôles.</td></tr>
            <tr><td><code>Notification</code>, <code>ActivityLog</code></td><td>Notifications internes et journal d'activité.</td></tr>
        </tbody>
    </table>
